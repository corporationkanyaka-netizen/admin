# Copy to .env.local and fill in.
# Same PostgreSQL database as the website (kanyaka-marketing).
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/kanyaka?schema=public"

# Gmail that sends customer emails + sign-in links: the address and a 16-character App Password.
# The Desk also reads customer replies from this inbox over IMAP (enable IMAP in Gmail settings).
SMTP_USER=""
SMTP_PASS=""
# Optional overrides
MAIL_FROM=""
REPLY_TO=""
IMAP_HOST=""

# Public address of this Desk (sign-in links point here). Required in production.
DESK_URL="http://localhost:3002"
# Website address (logo in emails)
SITE_URL="https://kanyaka-marketing.vercel.app"
